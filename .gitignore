.venv/
__pycache__/
*.py[cod]
analysis/cash.duckdb
output_hackspain_data*.zip
output/

# Publicación regenerable: la produce el job y se sube a Supabase, no al repositorio.
# Se rehace con scripts/export_decision_publication.py y
# research/src/export_health_publication.py (ver frontend/DEPLOYMENT.md).
supabase/export/

# Local environment credentials, at any depth.
# DECRYPT_KEY lives here; used by scripts/vault.py.
.env
.env.*
!.env.example

# Working copies of vaulted directories: sus datos, artefactos y salidas (panel,
# xray.joblib, notas OOF) se regeneran y nunca se versionan. Restore with:
#   python3 scripts/vault.py decrypt
# Encrypted packs live in vault/*.enc and are versioned.
/context/
/notebooks/
/research/
/analysis/
/docs/

# Machine-local Claude permissions and authentication preferences.
.claude/settings.local.json
.playwright-mcp/

# impeccable: herramienta de diseño local, cada uno la instala con `npx impeccable install`.
.claude/skills/impeccable/
.claude/agents/impeccable-*
.impeccable/
