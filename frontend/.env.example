# Optional. When omitted, Nitro serves the built-in development portfolio.
XRAY_API_BASE=http://localhost:8080

# Supabase: public browser configuration.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional server-only configuration; never use a NUXT_PUBLIC_ prefix.
NUXT_SUPABASE_SECRET_KEY=
NUXT_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Assistant (server-only). Needs XRAY_API_BASE above. Pick one:
# 1) Any OpenAI-compatible server (Ollama, vLLM, an open-model provider). AGENT_MODEL is required.
#      Ollama:  AGENT_BASE_URL=http://localhost:11434/v1  AGENT_MODEL=qwen3:8b   (no key needed)
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
# 2) Vercel AI Gateway (used when AGENT_BASE_URL is empty). On Vercel, OIDC is used and this can stay empty.
#    AGENT_MODEL is optional here; defaults to anthropic/claude-opus-5.
AI_GATEWAY_API_KEY=
