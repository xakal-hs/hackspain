# Optional. When omitted, Nitro serves the built-in development portfolio.
XRAY_API_BASE=http://localhost:8080

# Supabase: public browser configuration.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional server-only configuration; never use a NUXT_PUBLIC_ prefix.
NUXT_SUPABASE_SECRET_KEY=
NUXT_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
