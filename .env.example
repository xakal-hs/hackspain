# Fernet key used by scripts/vault.py to decrypt context/, notebooks/,
# research/ and analysis/. Copy to .env; never commit the real value.
DECRYPT_KEY=

# https://eisukkwjjyatitoyatuy.supabase.co
SUPABASE_URL=https://eisukkwjjyatitoyatuy.supabase.co
SUPABASE_PROJECT_REF=eisukkwjjyatitoyatuy

# Optional. Session-mode URI (port 5432), not the transaction pooler.
# If omitted, scripts/push_supabase.py creates role xray_loader via the Management API
# using the token from `supabase login`.
# SUPABASE_DB_URL=postgresql://postgres.eisukkwjjyatitoyatuy:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional override of the CLI personal access token (sbp_...).
# SUPABASE_ACCESS_TOKEN=

# Set to 1 to load invoices + transactions on a Free plan (likely to hit the 500 MB cap).
# XRAY_FORCE_LARGE_TABLES=0
