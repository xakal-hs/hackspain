# Fernet key used by scripts/vault.py to decrypt context/, notebooks/,
# research/, analysis/ and docs/. Copy to .env; never commit the real value.
DECRYPT_KEY=

# Proyecto Supabase que sirve la aplicación. Los scripts de scripts/ leen estas dos.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project

# Clave de servicio: solo la usan los cargadores y el servidor de Nitro. Nunca el navegador.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Solo para aplicar los .sql de supabase/. El host directo es IPv6; desde IPv4 hay que ir
# por el pooler de la región del proyecto (aws-0-<region>.pooler.supabase.com, usuario
# postgres.<ref>).
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PASSWORD=

# Optional. Session-mode URI (port 5432), not the transaction pooler.
# If omitted, scripts/push_supabase.py creates role xray_loader via the Management API
# using the token from `supabase login`.
# SUPABASE_DB_URL=postgresql://postgres.eisukkwjjyatitoyatuy:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional override of the CLI personal access token (sbp_...).
# SUPABASE_ACCESS_TOKEN=

# Set to 1 to load invoices + transactions on a Free plan (likely to hit the 500 MB cap).
# XRAY_FORCE_LARGE_TABLES=0
